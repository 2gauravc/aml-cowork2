# Set true to run the credential-free, fixture-backed local demo.
DEMO_MODE=true

# Live mode only: set DEMO_MODE=false and provide these values.
KYCBASEURL=https://api.knowyourcustomer.dev
KYCCLIENTID=
KYCCLIENTSECRET=
OPENAI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional model overrides. All workflows default to GPT-5.6.
OPENAI_MODEL=gpt-5.6
OPENAI_CSP_MODEL=gpt-5.6
OPENAI_CASE_REVIEW_MODEL=gpt-5.6
OPENAI_DOCUMENT_MODEL=gpt-5.6
OPENAI_POLICY_MODEL=gpt-5.6
OPENAI_ADVERSE_NEWS_MODEL=gpt-5.6
OPENAI_DIGITAL_FOOTPRINT_MODEL=gpt-5.6
OPENAI_OTHER_RISK_FACTORS_MODEL=gpt-5.6
OPENAI_SHELL_COMPANY_RISK_MODEL=gpt-5.6
OPENAI_RISK_RATING_MODEL=gpt-5.6

# Optional workflow and diagnostic controls.
OPENAI_QA_ENABLED=
CDD_PIPELINE_NODE_MIN_SECONDS=3
KYC_CACHE_PATH=
CDD_DEBUG=false
CDD_DEBUG_DIR=outputs/debug
CDD_DEBUG_FILE=
CDD_DEBUG_MAX_VALUE_CHARS=10000

# Optional persistent KYC API cache. Leave blank to retain the local JSON cache.
KYC_CACHE_S3_BUCKET=
KYC_CACHE_S3_PREFIX=kyc-cache

# Completed CDD snapshots are persisted only after a pipeline finishes. Leave
# the bucket blank to reuse KYC_CACHE_S3_BUCKET; objects use this separate prefix.
CDD_STATE_S3_BUCKET=
CDD_STATE_S3_PREFIX=cdd-states

# Optional live-mode S3 document storage. boto3 uses the standard credential
# chain: an EC2 instance role in AWS, or an AWS profile/environment locally.
S3_DOCUMENT_BUCKET_URL=
S3_DOCUMENT_BUCKET=
S3_DOCUMENT_PREFIX=
AWS_REGION=
