# Use true for the credential-free fixture demo. Set false for live workflows.
DEMO_MODE=true

# KYC sandbox credentials. Request access at:
# https://knowyourcustomer.com/developers/access/
KYCBASEURL=https://api.knowyourcustomer.dev
KYCCLIENTID=
KYCCLIENTSECRET=

# AI and web-research credentials. Required for the relevant live workflows.
OPENAI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional LangSmith runtime tracing. Traces are operational telemetry, not CDD
# evidence. Enable only after approving data handling, retention, and access.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=onbo

# Optional shared KYC cache: persists KYC API responses between app restarts.
KYC_CACHE_S3_BUCKET=
KYC_CACHE_S3_PREFIX=kyc-cache

# Optional completed-case store: retains final CDD state snapshots. Leave the
# bucket blank to reuse KYC_CACHE_S3_BUCKET with this separate prefix.
CDD_STATE_S3_BUCKET=
CDD_STATE_S3_PREFIX=cdd-states

# Optional document store: persists generated and uploaded documents outside
# the application container. boto3 uses an EC2 role in AWS or your local AWS
# profile; do not put static AWS access keys in this file.
S3_DOCUMENT_BUCKET=
S3_DOCUMENT_PREFIX=
AWS_REGION=
